    sosa:hasSimpleResult 6.8 ;
    sosa:madeBySensor ex:Sensor_Zone_513_5402 ;
    sosa:observedProperty uhi:DailyMaxTemperature ;
    sosa:resultTime "2024-01-01"^^xsd:date .

